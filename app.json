{
  "expo": {
    "name": "signifiya",
    "slug": "signifiya",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true,
        "UIViewControllerBasedStatusBarAppearance": false
      },
      "bundleIdentifier": "com.abhishek2304.signifiya"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "package": "com.abhishek2304.signifiya"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "signifiya",
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-updates"
    ],
    "owner": "tushardevx01",
    "extra": {
      "eas": {
        "projectId": "0d16532d-08f7-4ab7-abbf-ce89633560b3"
      }
    }
  }
}

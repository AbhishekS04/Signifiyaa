{
  "expo": {
    "name": "signifiya",
    "slug": "signifiya",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "bundleIdentifier": "com.abhishek2304.signifiya"
    },
    "android": {
      "package": "com.tushardevx001.signifiya",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-video",
      "expo-web-browser",
      "expo-updates",
      "./plugins/withHighRefreshRate"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "scheme": "signifiya",
    "owner": "tushardevx001",
    "extra": {
      "eas": {
        "projectId": "1670b066-ffec-44db-bc23-08f55cf381d7"
      }
    }
  }
}
